from flask import Flask, render_template, request, jsonify, send_from_directory
import asyncio
import os
import uuid
import edge_tts
import re

app = Flask(__name__)

OUTPUT_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "output")
os.makedirs(OUTPUT_DIR, exist_ok=True)

VOICES = {
    "female": "hi-IN-SwaraNeural",
    "male": "hi-IN-MadhurNeural"
}


def clamp(value, low, high):
    return max(low, min(high, value))


def clean_text(text):
    """Remove any pause markup so it can never be spoken aloud."""
    text = re.sub(r'<\s*break[^>]*>', ' ', text, flags=re.I)
    text = re.sub(r'</?[^>]+>', ' ', text)
    text = re.sub(r'[ \t]+', ' ', text)
    return text.strip()


def add_natural_punctuation(text, style):
    """
    Uses only normal punctuation. No SSML/break tags are inserted.
    This keeps Edge TTS from speaking technical pause text.
    """
    text = clean_text(text)

    # Normalize repeated punctuation
    text = re.sub(r'\.{4,}', '...', text)
    text = re.sub(r'([!?।]){2,}', r'\1', text)

    # Story/suspense can use punctuation already present in the script.
    # We deliberately do not insert <break> tags.
    if style == "suspense":
        text = text.replace("।", "...")
    elif style == "story":
        text = text.replace("।", "।")
    else:
        text = text.replace("।", "।")

    return text


async def make_mp3(text, voice, rate, pitch, filename):
    communicate = edge_tts.Communicate(
        text,
        voice,
        rate=rate,
        volume="+0%",
        pitch=pitch
    )
    await communicate.save(filename)


@app.route("/")
def index():
    return render_template("index.html")


@app.route("/generate", methods=["POST"])
def generate():
    data = request.get_json(silent=True) or {}

    original_text = (data.get("text") or "").strip()
    gender = data.get("gender", "female")
    style = data.get("style", "natural")
    voice_type = data.get("type", "normal")

    voice = VOICES.get(gender, VOICES["female"])

    if not original_text:
        return jsonify({
            "ok": False,
            "error": "Pehle text paste karein."
        }), 400

    if len(original_text) > 12000:
        return jsonify({
            "ok": False,
            "error": "Abhi ek baar me 12,000 characters tak use karein."
        }), 400

    try:
        default_speeds = {
            "natural": 0.94,
            "story": 0.90,
            "suspense": 0.86,
            "fast": 1.10
        }

        speed = float(
            data.get("speed", default_speeds.get(style, 0.94))
        )
        speed = clamp(speed, 0.5, 2.0)

        rate_percent = int(round((speed - 1.0) * 100))
        rate = "{:+d}%".format(rate_percent)

        base_pitch = {
            "heavy": -25,
            "normal": 0,
            "thin": 25
        }.get(voice_type, 0)

        tone = float(data.get("tone", 0))
        tone = clamp(tone, -35, 35)

        final_pitch = int(round(base_pitch + tone))
        pitch = "{:+d}Hz".format(final_pitch)

        text = add_natural_punctuation(original_text, style)

        filename = "manjeet_natural_{}.mp3".format(
            uuid.uuid4().hex
        )
        path = os.path.join(OUTPUT_DIR, filename)

        asyncio.run(
            make_mp3(
                text,
                voice,
                rate,
                pitch,
                path
            )
        )

        if not os.path.isfile(path):
            return jsonify({
                "ok": False,
                "error": "MP3 file create nahi hui."
            }), 500

        return jsonify({
            "ok": True,
            "url": "/output/" + filename,
            "filename": filename,
            "voice": voice,
            "style": style,
            "rate": rate,
            "pitch": pitch
        })

    except Exception as e:
        return jsonify({
            "ok": False,
            "error": "TTS generate nahi hua: " + str(e)
        }), 500


@app.route("/output/<path:filename>")
def output_file(filename):
    file_path = os.path.join(OUTPUT_DIR, filename)

    if not os.path.isfile(file_path):
        return "MP3 file nahi mili.", 404

    return send_from_directory(
        OUTPUT_DIR,
        filename,
        as_attachment=False
    )


@app.route("/download/<path:filename>")
def download_file(filename):
    file_path = os.path.join(OUTPUT_DIR, filename)

    if not os.path.isfile(file_path):
        return "MP3 file nahi mili.", 404

    return send_from_directory(
        OUTPUT_DIR,
        filename,
        as_attachment=True,
        download_name=filename
    )


if __name__ == "__main__":
    print("")
    print("====================================")
    print("       MANJEET NATURAL TTS")
    print("====================================")
    print("Computer: http://127.0.0.1:5000")
    print("")
    print("Server is running...")
    print("Keep this black window OPEN.")
    print("")

    app.run(
        host="0.0.0.0",
        port=5000,
        debug=False
    )
